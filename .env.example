# Configuration for Antigravity Remote
# Copy this file to .env and set your custom values

# (Optional) Your custom domain on Cloudflare. If omitted, a free trycloudflare.com URL will be generated.
CUSTOM_DOMAIN=my-antigravity.yourdomain.com

# (Optional) Secret passkey to protect your session. If omitted, a random secure token is generated on startup.
SECRET_TOKEN=change_this_to_your_secure_passkey

# (Optional) Cloudflare Named Tunnel name
TUNNEL_NAME=antigravity-tunnel
